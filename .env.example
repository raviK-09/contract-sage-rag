# ── LLM Configuration ──────────────────────────────────────────────────────────
# Ollama must be running locally: https://ollama.com
# After installing Ollama, run: ollama pull llama3.1:8b
OLLAMA_BASE_URL=http://localhost:11434

# Primary LLM for answer generation
# Options: llama3.1:8b | llama3.1:70b | mistral:7b | phi3:mini | gemma2:9b
LLM_MODEL=llama3.1:8b

# Lightweight fallback model (used when confidence is low or for fast responses)
LLM_MODEL_FALLBACK=phi3:mini

# LLM generation parameters
LLM_TEMPERATURE=0.1          # Low temperature = factual, deterministic answers
LLM_MAX_TOKENS=1024

# ── Embedding Configuration ────────────────────────────────────────────────────
# Local embedding model via sentence-transformers (no API key needed!)
# Options: all-MiniLM-L6-v2 (fast) | BGE-small-en-v1.5 (better) | BGE-large-en-v1.5 (best, slower)
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Set to "cuda" for GPU acceleration, "cpu" for CPU-only
EMBEDDING_DEVICE=cpu

# ── Vector Store Configuration ─────────────────────────────────────────────────
# ChromaDB will persist data here (relative to project root)
CHROMA_PERSIST_DIR=./data/chroma_db
CHROMA_COLLECTION_NAME=contract_documents

# ── Chunking Configuration ─────────────────────────────────────────────────────
# Trade-off: larger chunks = more context but less precise retrieval
# Smaller chunks = more precise but may miss context
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# ── Retrieval Configuration ────────────────────────────────────────────────────
# Number of chunks to retrieve per query
TOP_K=5

# Hybrid retrieval weights (must sum to 1.0)
# Trade-off: higher DENSE_WEIGHT = better semantic match
#            higher BM25_WEIGHT  = better keyword/exact term match
DENSE_WEIGHT=0.7
BM25_WEIGHT=0.3

# MMR diversity parameter (0.0 = max relevance, 1.0 = max diversity)
MMR_LAMBDA=0.5

# ── Confidence & Decline Configuration ────────────────────────────────────────
# If combined confidence score < this threshold, system declines to answer
# Range: 0.0 - 1.0 | Recommended: 0.35 - 0.50
CONFIDENCE_THRESHOLD=0.40

# Minimum average similarity score for retrieved chunks to count as "relevant"
MIN_SIMILARITY_THRESHOLD=0.30

# ── API Configuration ──────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true                # Set to false in production
API_LOG_LEVEL=info

# ── Evaluation Configuration ───────────────────────────────────────────────────
# LLM used as judge for RAGAS evaluation (uses same Ollama instance)
EVAL_JUDGE_MODEL=llama3.1:8b
EVAL_DATASET_PATH=./data/eval_dataset.json
EVAL_RESULTS_DIR=./data/eval_results

# ── Application Settings ───────────────────────────────────────────────────────
APP_NAME=ContractSage
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO
